# Reference values only: this file is not loaded automatically.
# Pass the frontend value with --dart-define when starting/building Flutter.
RIPPLEMAP_API_URL=http://localhost:8082

# Backend variables must be set in the Serverpod process environment.
# Register this exact URL as the GitHub OAuth callback.
GITHUB_REDIRECT_URI=http://localhost:8082/auth/github/callback
GITHUB_OAUTH_SCOPE=public_repo
RIPPLEMAP_FRONTEND_ORIGIN=http://localhost:5000

# GitHub OAuth App.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Generate a random 32-byte key and encode it as base64.
SESSION_ENCRYPTION_KEY=

# Required by Serverpod server-side session hashing when using the email identity provider.
# Generate a strong random 32-byte value and store it in config/passwords.yaml under the
# matching run mode as `serverSideSessionKeyHashPepper`, or provide it as an env var.
SERVERPOD_PASSWORD_serverSideSessionKeyHashPepper=

# Optional: Serverpod Cloud email provider only. Local dev can use verification codes in logs.
# Production/staging require real credentials supplied to the Serverpod Cloud email config.
SERVERPOD_PASSWORD_scloudAuthEmailKey=

# Groq is optional. The backend verifies model availability via /models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
